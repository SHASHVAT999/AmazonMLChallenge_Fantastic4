# ============================================================
# Datasets / raw & derived data
# ============================================================
# Challenge dataset copies (both dataset/ and amazon_docs/student_resource/dataset/
# match, since a slash-free pattern matches a directory of that name at any depth).
data/
dataset/
datasets/
train/
test/
validation/
val/
DatasetForMLChallenge.zip

# Common large/raw data file formats
*.csv
*.tsv
*.json
*.jsonl
*.parquet
*.feather
*.pkl
*.pickle
*.h5
*.hdf5
*.npz
*.npy
*.zip
*.tar
*.tar.gz
*.tgz
*.gz

# Config/metadata JSON files that ARE part of the source tree and must stay
# tracked despite the blanket *.json rule above.
!skills-lock.json

